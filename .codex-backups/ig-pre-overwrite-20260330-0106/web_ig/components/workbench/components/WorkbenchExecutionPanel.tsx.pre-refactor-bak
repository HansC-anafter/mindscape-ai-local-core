import React, { useCallback, useEffect, useMemo, useRef, useState } from 'react';
import {
  Activity,
  AlertCircle,
  ChevronDown,
  ChevronUp,
  Copy,
  CheckSquare,
  Download,
  History,
  Loader2,
  RefreshCw,
  Sparkles,
  Upload,
  X,
} from 'lucide-react';

import ReadyScore from '../../ReadyScore';
import type { IGPost } from '../../types';
import { useExecutionPolling } from '@/hooks/useExecutionPolling';

function parseTimestamp(value?: string | null): Date | null {
  if (!value) return null;
  const s = value.trim();
  if (!s) return null;
  const hasTimezone = /[zZ]$|[+-]\d{2}:\d{2}$/.test(s);
  // Bare timestamps from our DB are already in local time (server CST/UTC+8).
  // Do NOT append 'Z' — let the browser Date constructor parse as local.
  const d = new Date(hasTimezone ? s : s.replace(' ', 'T'));
  if (!Number.isFinite(d.getTime())) return null;
  return d;
}

function formatLocalDateTime(value?: string | null): string {
  const d = parseTimestamp(value);
  if (!d) return '—';
  return d.toLocaleString();
}

function formatLocalTime(value?: string | null): string {
  const d = parseTimestamp(value);
  if (!d) return '—';
  return d.toLocaleTimeString();
}

function minutesAgo(value?: string | null): number | null {
  const t = parseTimestamp(value)?.getTime();
  if (!Number.isFinite(t)) return null;
  const diffMs = Date.now() - (t as number);
  if (!Number.isFinite(diffMs) || diffMs < 0) return null;
  return Math.floor(diffMs / 60000);
}

function shortId(id: string): string {
  const s = (id || '').toString();
  if (!s) return '';
  return s.length > 8 ? `${s.slice(0, 8)}…` : s;
}

export function WorkbenchExecutionPanel(props: {
  workspaceId: string;
  apiUrl: string;
  selectedPostId: string | null;
  getSelectedPost: () => IGPost | null;
  posts: IGPost[];
  statusFilter: 'draft' | 'review' | 'ready' | 'scheduled' | 'published' | 'measured' | 'all';

  recentRuns: any[];
  isRunning: boolean;
  error: string | null;
  onDismissError: () => void;
  onRunPlaybook: (playbookCode: string, additionalInputs?: any) => Promise<{ success: boolean; execution_id?: string; error?: string }>;
  onRefreshRuns?: () => void;
}) {
  const {
    workspaceId,
    apiUrl,
    selectedPostId,
    getSelectedPost,
    posts,
    statusFilter,
    recentRuns,
    isRunning,
    error,
    onDismissError,
    onRunPlaybook,
    onRefreshRuns,
  } = props;

  const [activeTab, setActiveTab] = useState<'logs' | 'actions' | 'ready'>('logs');
  const [rerunBusyId, setRerunBusyId] = useState<string | null>(null);
  const [rerunNotice, setRerunNotice] = useState<string | null>(null);
  const [rerunNeedsTarget, setRerunNeedsTarget] = useState<{ executionId: string } | null>(null);
  const [rerunTargetInput, setRerunTargetInput] = useState<string>('');
  const [cancelBusyId, setCancelBusyId] = useState<string | null>(null);
  const [cancelNotice, setCancelNotice] = useState<string | null>(null);

  const [batchAction, setBatchAction] = useState<'batch_validate' | 'batch_generate_export_packs' | 'batch_update_status' | 'batch_process'>('batch_validate');
  const [batchScope, setBatchScope] = useState<'selected' | 'filtered' | 'manual'>('filtered');
  const [batchManualPostPaths, setBatchManualPostPaths] = useState('');
  const [batchStrictMode, setBatchStrictMode] = useState(false);
  const [igRerunAllowPartial, setIgRerunAllowPartial] = useState(false);
  const [batchOutputFolder, setBatchOutputFolder] = useState('export_packs');
  const [batchNewStatus, setBatchNewStatus] = useState<'draft' | 'review' | 'ready' | 'scheduled' | 'published' | 'measured' | 'archived'>('review');
  const [batchOperationsText, setBatchOperationsText] = useState('validate\nexport_pack');
  const [batchOperationConfigText, setBatchOperationConfigText] = useState('{}');
  const [batchNotice, setBatchNotice] = useState<string | null>(null);

  const [workflowPreset, setWorkflowPreset] = useState<'create_post_workflow' | 'review_workflow' | 'execute_workflow'>('create_post_workflow');
  const [workflowTargetFolder, setWorkflowTargetFolder] = useState('posts');
  const [workflowPostContent, setWorkflowPostContent] = useState('');
  const [workflowPostMetadataText, setWorkflowPostMetadataText] = useState('{}');
  const [workflowStepsText, setWorkflowStepsText] = useState('[]');
  const [workflowInitialContextText, setWorkflowInitialContextText] = useState('{}');
  const [workflowReviewNotesText, setWorkflowReviewNotesText] = useState('[]');
  const [workflowNotice, setWorkflowNotice] = useState<string | null>(null);

  const [igDebugLoading, setIgDebugLoading] = useState(false);
  const [igDebugError, setIgDebugError] = useState<string | null>(null);
  const [igDebugExpanded, setIgDebugExpanded] = useState(false);
  const [forcedExecution, setForcedExecution] = useState<null | {
    executionId: string;
    playbookCode: string;
    startedAt: string | null;
  }>(null);
  const backendHintCacheRef = useRef<Record<string, string | null | undefined>>({});
  const igDebugInFlightRef = useRef(false);
  const [igDebug, setIgDebug] = useState<null | {
    executionId: string;
    updatedAt: string | null;
    stage: string | null;
    iter: number | null;
    targets: number | null;
    expectedFollowing: number | null;
    stopReason: string | null;
    listCaptureStatus: string | null;
    executionBackendHint: string | null;
    visitAccountPages: boolean | null;
    savedDedupTargets: number | null;
    pageIndex: number | null;
    pageTotal: number | null;
    currentAccount: string | null;
    noChangeCount: number | null;
    noNewAccountsStreak: number | null;
    reachedBottom: boolean | null;
    errorType: string | null;
    errorMessage: string | null;
    scrollMode: string | null;
    runMode: string | null;
    allowPartialResume: boolean | null;
    screenshots: string[];
  }>(null);

  const latestIGRun = useMemo(() => {
    const runs = Array.isArray(recentRuns) ? recentRuns : [];
    const igRuns = runs.filter(
      (r) => (r?.playbook_code || '').toString() === 'ig_analyze_following' && (r?.execution_id || r?.id)
    );
    const toTs = (r: any) => {
      const v =
        r?.created_at ||
        r?.started_at ||
        r?.task?.created_at ||
        r?.task?.started_at ||
        null;
      const d = parseTimestamp(v);
      return d ? d.getTime() : 0;
    };
    const getPriority = (r: any) => {
      const s = (r?.status || '').toString().toLowerCase();
      if (s === 'running') return 2;
      if (['pending', 'queued', 'paused'].includes(s)) return 1;
      return 0;
    };
    igRuns.sort((a, b) => {
      const pa = getPriority(a);
      const pb = getPriority(b);
      if (pa !== pb) return pb - pa;
      return toTs(b) - toTs(a);
    });
    return igRuns[0] || null;

  }, [recentRuns]);

  const igExecutionId = useMemo(() => {
    const runs = Array.isArray(recentRuns) ? recentRuns : [];
    // Priority 1: Currently running IG task
    const runningIG = runs.find((r) =>
      (r?.playbook_code || '').toString() === 'ig_analyze_following' &&
      (r?.status || '').toString().toLowerCase() === 'running'
    );
    if (runningIG) {
      return (runningIG.execution_id || runningIG.id || '').toString();
    }
    // Priority 2: Forced execution (from rerun click)
    const forced = (forcedExecution?.executionId || '').toString().trim();
    if (forced) return forced;
    // Priority 3: Latest IG run
    return (latestIGRun?.execution_id || latestIGRun?.id || '').toString() || null;
  }, [recentRuns, forcedExecution?.executionId, latestIGRun?.execution_id, latestIGRun?.id]);

  const igPinnedRun = useMemo(() => {
    const runs = Array.isArray(recentRuns) ? recentRuns : [];
    const execId = (igExecutionId || '').toString();
    if (!execId) return null;
    const found = runs.find((r) => (r?.execution_id || r?.id || '').toString() === execId);
    if (found) return found;
    // If forcedExecution exists but not yet in recentRuns, create a temporary pending run object
    if (forcedExecution?.executionId === execId) {
      return {
        execution_id: execId,
        id: execId,
        status: 'pending',
        playbook_code: forcedExecution.playbookCode || 'ig_analyze_following',
        started_at: forcedExecution.startedAt || new Date().toISOString(),
      };
    }
    return null;
  }, [recentRuns, igExecutionId, forcedExecution]);

  const canRerunStatus = useCallback((status: any) => {
    const s = (status || '').toString();
    // Allow rerun for terminal runs, including succeeded/completed,
    // because "completed_partial" is represented as task_status=succeeded.
    return ['failed', 'cancelled_by_user', 'cancelled', 'succeeded', 'completed'].includes(s);
  }, []);

  useEffect(() => {

    const forcedId = (forcedExecution?.executionId || '').toString().trim();
    if (!forcedId) return;

    const pinnedStatus = (igPinnedRun?.status || '').toString();
    const isTerminal = ['completed', 'failed', 'cancelled_by_user', 'cancelled'].includes(pinnedStatus);
    if (!isTerminal) return;

    const latestId = (latestIGRun?.execution_id || latestIGRun?.id || '').toString();
    if (!latestId || latestId === forcedId) return;

    setForcedExecution(null);
  }, [forcedExecution?.executionId, igPinnedRun?.status, latestIGRun?.execution_id, latestIGRun?.id]);

  useEffect(() => {

    const handler = (evt: Event) => {
      const e = evt as CustomEvent<any>;
      const d = e?.detail || {};
      const wid = (d.workspaceId || '').toString();
      const execId = (d.executionId || '').toString();
      const code = (d.playbookCode || '').toString();
      if (!wid || !execId) return;
      if (wid !== workspaceId) return;

      // Bring the user to Run Logs so the "status card" is visible immediately.
      setActiveTab('logs');
      onRefreshRuns?.();

      // Pin IG Following Analyzer debug card (works even before runs list updates).
      if (code === 'ig_analyze_following') {
        setForcedExecution({
          executionId: execId,
          playbookCode: code,
          startedAt: (d.startedAt || null) as string | null,
        });
      }
    };

    if (typeof window !== 'undefined') {
      window.addEventListener('mindscape:execution_started', handler as any);
    }
    return () => {
      if (typeof window !== 'undefined') {
        window.removeEventListener('mindscape:execution_started', handler as any);
      }
    };
  }, [workspaceId, onRefreshRuns]);

  const fetchExecutionBackendHint = useCallback(
    async (executionId: string): Promise<string | null> => {
      const key = (executionId || '').toString();
      if (!key) return null;
      const cached = backendHintCacheRef.current[key];
      if (typeof cached !== 'undefined') return cached || null;
      try {
        const resp = await fetch(`${apiUrl}/api/v1/playbooks/execute/${key}/status`, {
          headers: { 'Content-Type': 'application/json' },
        });
        if (!resp.ok) {
          backendHintCacheRef.current[key] = null;
          return null;
        }
        const data = await resp.json().catch(() => ({}));
        const ctx = data?.execution_context || {};
        const hint = (ctx?.execution_backend_hint || ctx?.inputs?.execution_backend || '').toString().trim();
        backendHintCacheRef.current[key] = hint || null;
        return hint || null;
      } catch {
        backendHintCacheRef.current[key] = null;
        return null;
      }
    },
    [apiUrl]
  );

  const fetchLatestIGDebug = useCallback(async (showLoading = false) => {
    const executionId = igExecutionId;
    if (!executionId) return;
    if (igDebugInFlightRef.current) return;
    igDebugInFlightRef.current = true;

    // Only show loading indicator for manual refresh, not auto-polling
    if (showLoading) setIgDebugLoading(true);
    setIgDebugError(null);
    try {
      const artifactsPageLimit = 200;
      const maxPages = 5;
      let artifacts: any[] = [];
      let match: any = null;

      for (let page = 0; page < maxPages; page += 1) {
        const offset = page * artifactsPageLimit;
        const resp = await fetch(
          `${apiUrl}/api/v1/workspaces/${workspaceId}/artifacts?playbook_code=ig_analyze_following&platform=instagram&limit=${artifactsPageLimit}&offset=${offset}&include_content=false&include_preview=false`,
        );
        if (!resp.ok) {
          const data = await resp.json().catch(() => ({}));
          throw new Error((data.detail || resp.statusText || 'Failed to fetch artifacts').toString());
        }
        const data = await resp.json().catch(() => ({}));
        const pageArtifacts = Array.isArray(data.artifacts) ? data.artifacts : [];
        artifacts = artifacts.concat(pageArtifacts);

        const matches = pageArtifacts.filter((a: any) => {
          const m = a?.metadata || {};
          if ((m?.source || '').toString() !== 'ig_analyze_following_progress') return false;
          const mid = (m?.execution_id || m?.trace_id || a?.execution_id || '').toString();
          return mid === executionId;
        });
        if (matches.length > 0) {
          match = matches.sort((a: any, b: any) => {
            const ta = parseTimestamp(a?.updated_at || a?.created_at)?.getTime() || 0;
            const tb = parseTimestamp(b?.updated_at || b?.created_at)?.getTime() || 0;
            return tb - ta;
          })[0];
          break;
        }

        if (pageArtifacts.length < artifactsPageLimit) {
          break;
        }
      }

      if (!match) {
        setIgDebug(null);
        return;
      }

      const matchId = (match?.id || match?.artifact_id || '').toString();
      if (!matchId) {
        setIgDebug(null);
        return;
      }

      const detailResp = await fetch(
        `${apiUrl}/api/v1/artifacts/${matchId}?include_content=true&include_preview=false`,
      );
      if (!detailResp.ok) {
        const data = await detailResp.json().catch(() => ({}));
        throw new Error((data.detail || detailResp.statusText || 'Failed to fetch artifact detail').toString());
      }
      const detail = await detailResp.json().catch(() => ({}));
      const detailMeta = detail?.metadata || match?.metadata || {};
      const content = detail?.content || {};
      const progress = content?.progress || {};
      const meta = (content?.metadata && typeof content?.metadata === 'object') ? content.metadata : detailMeta;
      const screenshotsRaw = meta?.scroll_debug_screenshots || [];
      const screenshots = Array.isArray(screenshotsRaw) ? screenshotsRaw.filter(Boolean).map((x) => x.toString()) : [];

      const toIntOrNull = (v: any) => {
        const n = typeof v === 'number' ? v : parseInt((v ?? '').toString(), 10);
        return Number.isFinite(n) ? n : null;
      };

      // Fetch persisted targets count from database via /seed-status API
      const seed = (meta?.target_username || '').toString().trim();
      let savedDedupTargets: number | null = null;
      try {
        if (seed && workspaceId) {
          const statusResp = await fetch(
            `${apiUrl}/api/v1/ig/insights/seed-status?workspace_id=${encodeURIComponent(workspaceId)}&seed=${encodeURIComponent(seed)}`
          );
          if (statusResp.ok) {
            const statusData = await statusResp.json().catch(() => ({}));
            savedDedupTargets = typeof statusData.target_count === 'number' ? statusData.target_count : null;
          }
        }
      } catch {
        savedDedupTargets = null;
      }

      const backendHint = await fetchExecutionBackendHint(executionId);

      setIgDebug({
        executionId,
        updatedAt: ((detail?.updated_at || match?.updated_at || null)) as string | null,
        stage: (progress?.stage || meta?.stage || null) as string | null,
        iter: toIntOrNull(progress?.iteration),
        targets: toIntOrNull(progress?.total_accounts ?? meta?.total_accounts),
        expectedFollowing: toIntOrNull(meta?.expected_following_count),
        stopReason: (meta?.scroll_stop_reason || progress?.scroll_stop_reason || null) as string | null,
        listCaptureStatus: (meta?.list_capture_status || null) as string | null,
        executionBackendHint: backendHint,
        visitAccountPages: typeof meta?.visit_account_pages === 'boolean' ? meta.visit_account_pages : null,
        savedDedupTargets,
        pageIndex: toIntOrNull(progress?.page_index),
        pageTotal: toIntOrNull(progress?.page_total),
        currentAccount: (progress?.current_account || null) as string | null,
        noChangeCount: toIntOrNull(progress?.no_change_count),
        noNewAccountsStreak: toIntOrNull(progress?.no_new_accounts_streak),
        reachedBottom: typeof progress?.reached_bottom === 'boolean' ? progress.reached_bottom : null,
        errorType: (progress?.error_type || null) as string | null,
        errorMessage: (progress?.error_message || null) as string | null,
        scrollMode: (progress?.scroll_mode || null) as string | null,
        runMode: (progress?.run_mode || meta?.run_mode || null) as string | null,
        allowPartialResume: typeof progress?.allow_partial_resume === 'boolean' ? progress.allow_partial_resume : (typeof meta?.allow_partial_resume === 'boolean' ? meta.allow_partial_resume : null),
        screenshots,
      });
    } catch (e) {
      setIgDebugError(e instanceof Error ? e.message : 'Unknown error');
    } finally {
      setIgDebugLoading(false);
      igDebugInFlightRef.current = false;
    }
  }, [apiUrl, workspaceId, igExecutionId, fetchExecutionBackendHint]);

  const copyExecutionId = useCallback(async () => {
    const id = (igExecutionId || '').toString();
    if (!id) return;
    try {
      await navigator.clipboard.writeText(id);
    } catch {
      // ignore
    }
  }, [igExecutionId]);

  useEffect(() => {
    if (activeTab !== 'logs') return;
    if (!igExecutionId) return;
    void fetchLatestIGDebug();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [activeTab, igExecutionId]);

  // Unified SSE + polling fallback via useExecutionPolling
  const pollFn = useCallback(async () => {
    void fetchLatestIGDebug();
    onRefreshRuns?.();
  }, [fetchLatestIGDebug, onRefreshRuns]);

  const status = (igPinnedRun?.status || '').toString();
  const isActive = !status || ['running', 'queued', 'pending', 'paused'].includes(status);
  const shouldPoll = activeTab === 'logs' && !!igExecutionId && isActive;

  useExecutionPolling({
    executionId: shouldPoll ? igExecutionId : null,
    workspaceId,
    apiUrl,
    onUpdate: () => { /* SSE events trigger debounced pollFn */ },
    pollIntervalMs: 10_000,
    enableSSE: true,
    sseDebounceMs: 1_200,
    pollFn,
  });

  const screenshotUrl = (executionId: string, fullPath: string) => {
    const basename = fullPath.split('/').pop() || fullPath;
    return `${apiUrl}/api/v1/playbooks/execute/${executionId}/debug/screenshot?file=${encodeURIComponent(basename)}`;
  };

  const cancelExecution = async (executionId: string) => {
    setCancelNotice(null);
    setCancelBusyId(executionId);
    try {
      const resp = await fetch(`${apiUrl}/api/v1/playbooks/execute/${executionId}/cancel`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason: 'user_cancelled_from_execution_debug' }),
      });
      if (!resp.ok) {
        const data = await resp.json().catch(() => ({}));
        const detail = (data.detail || resp.statusText || '').toString();
        setCancelNotice(`Cancel failed: ${detail}`);
        return;
      }
      setCancelNotice('Cancelled');
      onRefreshRuns?.();
      void fetchLatestIGDebug();
    } catch (e) {
      setCancelNotice(`Cancel failed: ${e instanceof Error ? e.message : 'Unknown error'}`);
    } finally {
      setCancelBusyId(null);
    }
  };

  const rerunExecution = async (executionId: string, overrideInputs?: Record<string, any>) => {
    setRerunNotice(null);
    setRerunBusyId(executionId);
    try {
      const resp = await fetch(`${apiUrl}/api/v1/playbooks/execute/${executionId}/rerun`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(overrideInputs ? { override_inputs: overrideInputs } : {}),
      });
      if (!resp.ok) {
        const data = await resp.json().catch(() => ({}));
        const detail = (data.detail || resp.statusText || '').toString();
        if (resp.status === 409 && detail.toLowerCase().includes('missing target_username')) {
          setRerunNeedsTarget({ executionId });
          setRerunNotice('Rerun needs target username.');
        } else {
          setRerunNotice(`Rerun failed: ${detail}`);
        }
        return;
      }
      const data = await resp.json().catch(() => ({}));
      const newId = data.execution_id || data.result?.execution_id;
      if (newId) {
        setRerunNotice(`Rerun started: ${newId}`);
        // Immediately pin the sidebar debug card to the NEW execution id,
        // so SSE connects to the right stream (restores prior header-like behavior).
        try {
          const execId = newId.toString();
          setActiveTab('logs');
          setForcedExecution({
            executionId: execId,
            playbookCode: 'ig_analyze_following',
            startedAt: new Date().toISOString(),
          });
          // Also emit the shared event so other listeners stay consistent.
          if (typeof window !== 'undefined') {
            window.dispatchEvent(
              new CustomEvent('mindscape:execution_started', {
                detail: {
                  workspaceId,
                  executionId: execId,
                  playbookCode: 'ig_analyze_following',
                  startedAt: new Date().toISOString(),
                },
              })
            );
          }
        } catch {
          // ignore
        }
      } else {
        setRerunNotice('Rerun started');
      }
      setRerunNeedsTarget(null);
      setRerunTargetInput('');
      onRefreshRuns?.();
    } catch (e) {
      setRerunNotice(`Rerun failed: ${e instanceof Error ? e.message : 'Unknown error'}`);
    } finally {
      setRerunBusyId(null);
    }
  };

  const filteredPostPaths = useMemo(() => {
    const list = statusFilter === 'all' ? posts : posts.filter((p) => p.status === statusFilter);
    return list
      .map((p) => (p.post_path || '').toString().trim())
      .filter((p) => p.length > 0);
  }, [posts, statusFilter]);

  const selectedPostPath = useMemo(() => {
    const p = getSelectedPost();
    return (p?.post_path || '').toString().trim() || null;
  }, [getSelectedPost, selectedPostId]);

  const resolveBatchPostPaths = (): string[] => {
    if (batchScope === 'selected') {
      return selectedPostPath ? [selectedPostPath] : [];
    }
    if (batchScope === 'filtered') {
      return filteredPostPaths;
    }
    return batchManualPostPaths
      .split('\n')
      .map((s) => s.trim())
      .filter((s) => s.length > 0);
  };

  const runBatchProcessor = async () => {
    const postPaths = resolveBatchPostPaths();
    if (postPaths.length === 0) {
      alert('No post_paths resolved. Please select scope + provide paths.');
      return;
    }

    const additionalInputs: any = {
      action: batchAction,
      post_paths: postPaths,
      strict_mode: batchStrictMode,
    };

    if (batchAction === 'batch_generate_export_packs') {
      additionalInputs.output_folder = (batchOutputFolder || '').trim() || undefined;
    }
    if (batchAction === 'batch_update_status') {
      additionalInputs.new_status = batchNewStatus;
    }
    if (batchAction === 'batch_process') {
      const ops = batchOperationsText
        .split('\n')
        .map((s) => s.trim())
        .filter((s) => s.length > 0);
      additionalInputs.operations = ops.length > 0 ? ops : undefined;
      try {
        additionalInputs.operation_config = JSON.parse(batchOperationConfigText || '{}');
      } catch {
        additionalInputs.operation_config = undefined;
      }
    }

    const res = await onRunPlaybook('ig_batch_processor', additionalInputs);
    if (res.success) {
      setBatchNotice(`Started: ${res.execution_id || 'unknown'}`);
      setTimeout(() => setBatchNotice(null), 4000);
    }
  };

  const runCompleteWorkflow = async () => {
    const additionalInputs: any = { action: workflowPreset };

    if (workflowPreset === 'create_post_workflow') {
      const content = (workflowPostContent || '').trim();
      if (!content) {
        alert('Please input post_content');
        return;
      }
      additionalInputs.post_content = content;
      additionalInputs.target_folder = (workflowTargetFolder || '').trim() || undefined;
      try {
        additionalInputs.post_metadata = JSON.parse(workflowPostMetadataText || '{}');
      } catch {
        additionalInputs.post_metadata = {};
      }
    }

    if (workflowPreset === 'review_workflow') {
      if (!selectedPostPath) {
        alert('Please select a post with post_path');
        return;
      }
      additionalInputs.post_path = selectedPostPath;
      try {
        additionalInputs.review_notes = JSON.parse(workflowReviewNotesText || '[]');
      } catch {
        additionalInputs.review_notes = [];
      }
    }

    if (workflowPreset === 'execute_workflow') {
      try {
        additionalInputs.workflow_steps = JSON.parse(workflowStepsText || '[]');
      } catch {
        additionalInputs.workflow_steps = [];
      }
      try {
