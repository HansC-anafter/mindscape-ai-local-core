# Mindscape AI Local Core - Environment Variables
# Copy this file to .env and update with your values

# =============================================================================
# LLM Provider Configuration (Required for AI features)
# =============================================================================
# At least one API key is recommended for AI features to work.
# You can start the system without these, but some features will be unavailable.

# OpenAI API Key (optional but recommended)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API Key (optional but recommended)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Hugging Face API Token (optional, for HF Inference API tools)
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL configuration for vector storage (optional)
POSTGRES_DB=mindscape_vectors
POSTGRES_USER=mindscape
POSTGRES_PASSWORD=mindscape_password

# =============================================================================
# Server Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Timezone (optional, defaults to UTC)
# Examples: Asia/Shanghai, America/New_York, Europe/London
TZ=UTC

# =============================================================================
# Host Volume Locations (optional)
# =============================================================================
# By default Local-Core stores runtime state under ./data inside the repo.
# Override these when you want Docker volumes to live outside the repo,
# for example on an external SSD.
#
# Example:
# LOCAL_CORE_DATA_HOST_DIR=/Volumes/your-data-disk/mindscape-ai-local-core-runtime/data
# LOCAL_CORE_SECRETS_HOST_DIR=/Volumes/your-data-disk/mindscape-ai-local-core-runtime/data/secrets
# LOCAL_CORE_POSTGRES_HOST_DIR=/Volumes/your-data-disk/mindscape-ai-local-core-runtime/data/postgres
# LOCAL_CORE_TTS_VOICES_HOST_DIR=/Volumes/your-data-disk/mindscape-ai-local-core-runtime/data/tts/voices
# LOCAL_CORE_TTS_OUTPUT_HOST_DIR=/Volumes/your-data-disk/mindscape-ai-local-core-runtime/data/tts/output
# LOCAL_CORE_LOGS_HOST_DIR=/Volumes/your-data-disk/mindscape-ai-local-core-runtime/logs
#
# LOCAL_CORE_DATA_HOST_DIR=
# LOCAL_CORE_SECRETS_HOST_DIR=
# LOCAL_CORE_POSTGRES_HOST_DIR=
# LOCAL_CORE_TTS_VOICES_HOST_DIR=
# LOCAL_CORE_TTS_OUTPUT_HOST_DIR=
# LOCAL_CORE_LOGS_HOST_DIR=

# =============================================================================
# Sandbox Preview Configuration (optional)
# =============================================================================
# Port range for sandbox preview servers
SANDBOX_PREVIEW_PORT_START=3002
SANDBOX_PREVIEW_PORT_END=3020

# =============================================================================
# Security Configuration
# =============================================================================
# Local authentication secret (change in production!)
LOCAL_AUTH_SECRET=dev-secret-key-change-in-production

# =============================================================================
# Feature Flags
# =============================================================================
# Enable LLM-based intent extractor
ENABLE_LLM_INTENT_EXTRACTOR=true

# Disable legacy playbook fallback (D2: Legacy Cleanup)
PLAYBOOK_DISABLE_LEGACY=1

# Enable Wave 4 sparse routing prompt path for meeting orchestration.
# Fresh Wave 2-4 closure with REQUIRE_DYNAMIC_ROUTING=1 expects this to be true.
MEETING_DYNAMIC_ROUTING_ENABLED=false

# Enable Wave 3 routing graph trace persistence and stream events.
# Turn this on when you want session metadata / UI to surface routing graphs directly.
MEETING_DYNAMIC_ROUTING_TRACE_ENABLED=false

# =============================================================================
# Cloud Extension (Optional)
# =============================================================================
# Uncomment and configure if you want to connect to Mindscape AI Cloud
# CLOUD_API_URL=http://host.docker.internal:8002
# CLOUD_LICENSE_KEY=

# =============================================================================
# OCR Service Configuration (optional)
# =============================================================================
# Enable GPU for OCR (requires GPU support in Docker)
OCR_USE_GPU=false
# OCR language: ch (Chinese), en (English), etc.
OCR_LANG=ch

# =============================================================================
# Scene Generation Dispatch Observability (optional)
# =============================================================================
# Periodic dispatch backlog snapshot log interval in seconds. Set to 0 to disable.
SCENE_GENERATION_STATUS_LOG_INTERVAL_SECONDS=300
# Queue health warning thresholds used by /api/v1/system-settings/health/queue/metrics
SCENE_GENERATION_HEALTH_RUNNABLE_WARN_THRESHOLD=5
SCENE_GENERATION_HEALTH_DEFERRED_WARN_THRESHOLD=10
SCENE_GENERATION_HEALTH_COOLDOWN_BLOCKED_WARN_THRESHOLD=1
