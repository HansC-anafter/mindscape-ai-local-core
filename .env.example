# Mindscape AI Local Core - Environment Variables
# Copy this file to .env and update with your values

# =============================================================================
# LLM Provider Configuration (Required for AI features)
# =============================================================================
# At least one API key is recommended for AI features to work.
# You can start the system without these, but some features will be unavailable.

# OpenAI API Key (optional but recommended)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API Key (optional but recommended)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Hugging Face API Token (optional, for HF Inference API tools)
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL configuration for vector storage (optional)
POSTGRES_DB=mindscape_vectors
POSTGRES_USER=mindscape
POSTGRES_PASSWORD=mindscape_password

# =============================================================================
# Server Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Timezone (optional, defaults to UTC)
# Examples: Asia/Shanghai, America/New_York, Europe/London
TZ=UTC

# =============================================================================
# Runtime Backup Configuration
# =============================================================================
# Standard local-core backup mode is an incremental runtime backup: periodic
# physical PostgreSQL base backup plus WAL archive, and rsync file snapshots
# with link-dest hardlinks for unchanged files.
LOCAL_CORE_BACKUP_ROOT=
LOCAL_CORE_BACKUP_MIRROR_ROOT=
LOCAL_CORE_BACKUP_RETENTION_LOCAL_COUNT=7
LOCAL_CORE_BACKUP_RETENTION_MIRROR_COUNT=3
LOCAL_CORE_BACKUP_MIN_FREE_GB=20
LOCAL_CORE_BACKUP_REQUIRE_MIRROR=false
LOCAL_CORE_BACKUP_BASE_INTERVAL_HOURS=168
# Mirror copies only selected scopes by default. PostgreSQL base/WAL metadata,
# runtime compatibility metadata, and auth state are mirrored; blob storage,
# model cache, and workspace artifacts stay on the primary external disk unless
# explicitly added in Settings.
LOCAL_CORE_BACKUP_MIRROR_SCOPES=postgres_chain,runtime_metadata,auth_state

# PostgreSQL PITR/WAL archive is disabled by default. Set archive mode to on and
# keep the archive path inside LOCAL_CORE_BACKUP_ROOT before running incremental
# runtime backups.
LOCAL_CORE_POSTGRES_ARCHIVE_MODE=off
LOCAL_CORE_POSTGRES_WAL_ARCHIVE_HOST_DIR=./data/backups/local-runtime/postgres-wal-archive

# =============================================================================
# Sandbox Preview Configuration (optional)
# =============================================================================
# Port range for sandbox preview servers
SANDBOX_PREVIEW_PORT_START=3002
SANDBOX_PREVIEW_PORT_END=3020

# =============================================================================
# Security Configuration
# =============================================================================
# Local authentication secret (change in production!)
LOCAL_AUTH_SECRET=dev-secret-key-change-in-production

# =============================================================================
# Feature Flags
# =============================================================================
# Enable LLM-based intent extractor
ENABLE_LLM_INTENT_EXTRACTOR=true

# Disable legacy playbook fallback (D2: Legacy Cleanup)
PLAYBOOK_DISABLE_LEGACY=1

# =============================================================================
# Cloud Extension (Optional)
# =============================================================================
# Uncomment and configure if you want to connect to Mindscape AI Cloud
# CLOUD_API_URL=http://host.docker.internal:8002
# CLOUD_LICENSE_KEY=

# =============================================================================
# OCR Service Configuration (optional)
# =============================================================================
# Enable GPU for OCR (requires GPU support in Docker)
OCR_USE_GPU=false
# OCR language: ch (Chinese), en (English), etc.
OCR_LANG=ch
