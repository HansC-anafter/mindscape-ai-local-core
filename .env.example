# Mindscape AI Local Core - Environment Variables
# Copy this file to .env and update with your values

# =============================================================================
# LLM Provider Configuration (Required for AI features)
# =============================================================================
# At least one API key is recommended for AI features to work.
# You can start the system without these, but some features will be unavailable.

# OpenAI API Key (optional but recommended)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API Key (optional but recommended)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Hugging Face API Token (optional, for HF Inference API tools)
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=

# RunComfy API Token (optional, required for runcomfy_serverless_api provider gates)
# Keep the real value in local .env or a secret manager. Do not commit secrets.
RUNCOMFY_API_TOKEN=

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL configuration for vector storage (optional)
POSTGRES_DB=mindscape_vectors
POSTGRES_USER=mindscape
POSTGRES_PASSWORD=mindscape_password
POSTGRES_VECTOR_RUNTIME_USER=mindscape_vector_runtime
POSTGRES_VECTOR_RUNTIME_PASSWORD=

# =============================================================================
# Server Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Timezone (optional, defaults to UTC)
# Examples: Asia/Shanghai, America/New_York, Europe/London
TZ=UTC

# Remote Workbench Gateway (reverse proxy allowlist mode for remote front-end entry)
# Set to 1 to enable for frontend entry (e.g., Cloudflare Access / Tunnel path entry).
MOBILE_WORKBENCH_GATEWAY_ENABLED=
# Optional canonical public/mobile browser origin shown in gateway surfaces.
MOBILE_WORKBENCH_GATEWAY_PUBLIC_ORIGIN=
# Optional extra allowlist rules, comma-separated.
# Prefix syntax: "/my/path" (prefix match), Regex syntax: "regex:^/my/.+"
MOBILE_WORKBENCH_GATEWAY_EXTRA_PATH_RULES=
# Optional identity/workspace guardrails (comma-separated).
# Pack capability ingress is managed per workspace from the Gateway policy workbench.
# When any guardrail is configured, Access JWT must be present and satisfy configured constraints.
MOBILE_WORKBENCH_GATEWAY_ALLOWLIST_EMAILS=
MOBILE_WORKBENCH_GATEWAY_ALLOWLIST_GROUPS=
MOBILE_WORKBENCH_GATEWAY_WORKSPACE_ALLOWLIST=
# Optional JWT audience/issuer assertions when using Cloudflare Access Identity tokens.
MOBILE_WORKBENCH_GATEWAY_JWT_AUDIENCE=
MOBILE_WORKBENCH_GATEWAY_JWT_ISSUER=
# Clock skew tolerance for Access JWT exp/nbf validation (seconds).
MOBILE_WORKBENCH_GATEWAY_JWT_CLOCK_SKEW_SECONDS=
# JWT signature verification for Access JWT (RS/PS*):
# only needed when PUBLIC_KEY is supplied and REQUIRE_SIGNATURE_VERIFICATION=1.
MOBILE_WORKBENCH_GATEWAY_JWT_PUBLIC_KEY=
MOBILE_WORKBENCH_GATEWAY_JWT_PUBLIC_KEY_FILE=
MOBILE_WORKBENCH_GATEWAY_REQUIRE_SIGNATURE_VERIFICATION=
# Optional override for the gateway status surface used by the settings panel.
MOBILE_WORKBENCH_GATEWAY_HEALTH_URL=

# Formal remote live media relay. These values are read by the backend only;
# shared runners do not receive media signing material.
LOCAL_CORE_LIVE_MEDIA_WEBRTC_ORIGIN=https://media.mindscapeai.app
LOCAL_CORE_LIVE_MEDIA_RTMPS_ORIGIN=rtmps://media.mindscapeai.app:1936
LOCAL_CORE_LIVE_MEDIA_RTSPS_ORIGIN=rtsps://media.mindscapeai.app:8322
LOCAL_CORE_LIVE_MEDIA_JWT_PRIVATE_KEY_PATH=/root/.mindscape/live-media/media-private.pem
LOCAL_CORE_LIVE_MEDIA_JWT_KEY_ID=media-YYYY-MM
LOCAL_CORE_LIVE_MEDIA_JWT_ISSUER=https://remote-workbench.mindscapeai.app/media-auth
LOCAL_CORE_LIVE_MEDIA_JWT_AUDIENCE=mindscape-media-relay
LOCAL_CORE_LIVE_MEDIA_SESSION_TTL_SECONDS=14400
LOCAL_CORE_MOTION_RECEIVER_PYTHON=/opt/homebrew/opt/python@3.11/bin/python3.11

# =============================================================================
# Runtime Backup Configuration
# =============================================================================
# Standard local-core backup mode is an incremental runtime backup: periodic
# physical PostgreSQL base backup plus WAL archive, and rsync file snapshots
# with link-dest hardlinks for unchanged files.
# Keep this outside LOCAL_CORE_DATA_HOST_DIR. The default is its sibling path.
LOCAL_CORE_BACKUP_ROOT=./backups/local-runtime
LOCAL_CORE_BACKUP_MIRROR_ROOT=
LOCAL_CORE_BACKUP_RETENTION_LOCAL_COUNT=7
LOCAL_CORE_BACKUP_RETENTION_MIRROR_COUNT=3
LOCAL_CORE_BACKUP_MIN_FREE_GB=20
LOCAL_CORE_BACKUP_REQUIRE_MIRROR=false
LOCAL_CORE_BACKUP_BASE_INTERVAL_HOURS=168
# Mirror copies only selected scopes by default. PostgreSQL base/WAL metadata,
# runtime compatibility metadata, and auth state are mirrored; blob storage,
# model cache, and workspace artifacts stay on the primary external disk unless
# explicitly added in Settings.
LOCAL_CORE_BACKUP_MIRROR_SCOPES=postgres_chain,runtime_metadata,auth_state

# PostgreSQL PITR/WAL archive is disabled by default. Set archive mode to on and
# keep the archive path inside LOCAL_CORE_BACKUP_ROOT before running incremental
# runtime backups.
LOCAL_CORE_POSTGRES_ARCHIVE_MODE=off
LOCAL_CORE_POSTGRES_WAL_ARCHIVE_HOST_DIR=./backups/local-runtime/postgres-wal-archive

# =============================================================================
# Sandbox Preview Configuration (optional)
# =============================================================================
# Port range for sandbox preview servers
SANDBOX_PREVIEW_PORT_START=3002
SANDBOX_PREVIEW_PORT_END=3020

# =============================================================================
# Security Configuration
# =============================================================================
# Local authentication secret (change in production!)
LOCAL_AUTH_SECRET=dev-secret-key-change-in-production

# =============================================================================
# Feature Flags
# =============================================================================
# Enable LLM-based intent extractor
ENABLE_LLM_INTENT_EXTRACTOR=true

# Disable legacy playbook fallback (D2: Legacy Cleanup)
PLAYBOOK_DISABLE_LEGACY=1

# =============================================================================
# Cloud Extension (Optional)
# =============================================================================
# Uncomment and configure if you want to connect to Mindscape AI Cloud
# CLOUD_API_URL=http://host.docker.internal:8002
# CLOUD_LICENSE_KEY=

# =============================================================================
# OCR Service Configuration (optional)
# =============================================================================
# Enable GPU for OCR (requires GPU support in Docker)
OCR_USE_GPU=false
# OCR language: ch (Chinese), en (English), etc.
OCR_LANG=ch

# =============================================================================
# Local Voice Sidecar Configuration
# =============================================================================
# Whisper sidecar base URL and bounded proxy timeout budget (seconds).
WHISPER_SERVICE_URL=http://whisper-service:8006
WHISPER_MODEL=openai/whisper-small
WHISPER_TRANSCRIPTION_TIMEOUT_SECONDS=600

# XTTS sidecar base URL and bounded proxy timeout budget (seconds).
QWEN_QUALITY_VOICE_SERVICE_URL=http://host.docker.internal:8184
QWEN_QUALITY_VOICE_SYNTHESIS_TIMEOUT_SECONDS=240
XTTS_SYNTHESIS_TIMEOUT_SECONDS=180
# Exact executable pin for the read-only managed site release resource probe.
# Compute after checkout/deployment; never use a placeholder in runtime.
MINDSCAPE_RUNTIME_RESOURCE_PROBE=/app/scripts/managed_site_release_resource_probe.py
MINDSCAPE_RUNTIME_RESOURCE_PROBE_SHA256=
MINDSCAPE_WP_HUB_RELEASE_FACADE=/app/scripts/wp_hub_managed_release_bridge.py
MINDSCAPE_WP_HUB_RELEASE_FACADE_SHA256=
WP_HUB_RELEASE_SSH_HOST=
WP_HUB_RELEASE_SSH_PORT=22
WP_HUB_RELEASE_SSH_USER=
WP_HUB_RELEASE_SSH_IDENTITY_HOST_FILE=${HOME}/.ssh/id_rsa
WP_HUB_RELEASE_SSH_IDENTITY_FILE=/run/wp-hub-release/id
WP_HUB_RELEASE_SSH_IDENTITY_SHA256=
WP_HUB_RELEASE_SSH_KNOWN_HOSTS_HOST_FILE=${HOME}/.ssh/known_hosts
WP_HUB_RELEASE_SSH_KNOWN_HOSTS_FILE=/run/wp-hub-release/known_hosts
WP_HUB_RELEASE_SSH_KNOWN_HOSTS_SHA256=
# Set both values from one terminal wp-hub runtime install receipt.
WP_HUB_RELEASE_REMOTE_EXECUTABLE=
WP_HUB_RELEASE_REMOTE_EXECUTABLE_SHA256=
