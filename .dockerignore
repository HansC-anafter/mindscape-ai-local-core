# .dockerignore for local-core
# Exclude cloud packs, local-only artifacts, and internal files.

# ============================================
# Cloud Playbook Packs
# ============================================
# These paths are installed by CapabilityInstaller and must not enter the local-core image.
**/playbook-packs/**
backend/playbooks/packs-cloud/**
backend/packs/cloud/**
# Exclude cloud capability pack install locations.
backend/app/capabilities/**
web-console/src/app/capabilities/**
# Exclude any additional cloud integration service mirrors.
backend/app/services/cloud_providers/**
backend/app/services/cloud_sync/**

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv
.venv*/
**/.venv*/
**/.venv*/**
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# ============================================
# Node
# ============================================
node_modules/
**/node_modules/
**/node_modules/**
.pnpm-store/
**/.pnpm-store/
.next/
**/.next/
**/.next/**
.next*/
**/.next*/
**/.next*/**
**/.turbo/
**/.vite/
**/coverage/
**/.ignored/
out/
**/out/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# IDEs
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# OS
# ============================================
.DS_Store
Thumbs.db

# ============================================
# Data
# ============================================
# Local development data must not enter the image.
*.db
*.sqlite
data/
uploads/
logs/
*.log

# ============================================
# Environment
# ============================================
.env
.env.local
.env.*.local

# ============================================
# Temporary
# ============================================
_backups/
backups/
*.tmp
temp/
tmp/

# ============================================
# Test files
# ============================================
test_data/
*.test.*
*_test.py
*_test.json
*_test.yaml
test_*.py
test_*.json
test_*.yaml
tests/

# ============================================
# Internal documentation
# ============================================
docs-internal/
**/*_COMPLETE_REPORT.md
**/*_PROGRESS_REPORT.md
**/*_TODOS.md
**/*_TESTING*.md
**/*_TEST_LOG*.md
**/PHASE*.md
**/REFACTORING_*.md
**/ARCHITECTURE_NEUTRALITY_*.md
**/*DEBUG*.md
**/*_EXPERIENCE_SUMMARY.md
**/*_IMPLEMENTATION_*.md
**/ROUTES_CLASSIFICATION.md
**/*_CLASSIFICATION.md
**/*_ANALYSIS.md

# ============================================
# Internal scripts
# ============================================
scripts-internal/

# ============================================
# Agent tooling and local runtime caches
# ============================================
.agent/
.codex-backups/
.tmp/
.runtime-bundles/
backend/.tmp/
backend/.runtime-bundles/

# ============================================
# Local development overrides
# ============================================
docker-compose.override.yml
docker-compose.override.yml.example

# ============================================
# Git
# ============================================
.git
.gitignore

# ============================================
# Nested backend/backend/ (should not exist)
# ============================================
backend/backend/
