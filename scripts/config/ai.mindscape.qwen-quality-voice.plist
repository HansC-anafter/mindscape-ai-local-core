<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.mindscape.qwen-quality-voice</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON_BIN__</string>
    <string>__PROJECT_ROOT__/scripts/run-qwen-quality-voice-service.py</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8184</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>QWEN_QUALITY_RUNTIME_ROOT</key>
    <string>__RUNTIME_ROOT__</string>
    <key>QWEN_QUALITY_REFERENCE_AUDIO</key>
    <string>__REFERENCE_AUDIO__</string>
    <key>QWEN_QUALITY_REFERENCE_TEXT</key>
    <string>我約的是妝面加髮型嘛，所以會先帶去洗個頭。</string>
    <key>QWEN_QUALITY_STATE_DIR</key>
    <string>__STATE_DIR__</string>
    <key>QWEN_QUALITY_GENERATION_TIMEOUT_SECONDS</key>
    <string>240</string>
    <key>QWEN_QUALITY_MAX_TEXT_CHARS</key>
    <string>700</string>
    <key>QWEN_QUALITY_MAX_TOKENS</key>
    <string>4096</string>
    <key>QWEN_QUALITY_MAX_GENERATION_ATTEMPTS</key>
    <string>2</string>
    <key>HF_HUB_OFFLINE</key>
    <string>1</string>
    <key>TRANSFORMERS_OFFLINE</key>
    <string>1</string>
    <key>HF_DATASETS_OFFLINE</key>
    <string>1</string>
    <key>TOKENIZERS_PARALLELISM</key>
    <string>false</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/service.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/service.error.log</string>
</dict>
</plist>
