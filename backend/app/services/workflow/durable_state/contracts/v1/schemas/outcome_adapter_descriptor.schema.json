{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mindscape://durable-product-semantic-workflow/v1/outcome_adapter_descriptor",
  "title": "Neutral Product Outcome Adapter Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "descriptor_id",
    "port_id",
    "contract_export_id",
    "capability_identity",
    "selector",
    "input_schema_id",
    "output_schema_id",
    "entrypoint",
    "authorized_lane",
    "installed_artifact_sha256",
    "manifest_sha256",
    "descriptor_sha256",
    "activated_at",
    "signature"
  ],
  "properties": {
    "descriptor_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "port_id": {"const": "mindscape.product-outcome-adapter-port.v1"},
    "contract_export_id": {"const": "product_outcome_adapter"},
    "capability_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_code", "pack_version", "release_id"],
      "properties": {
        "capability_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "pack_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "release_id": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_states", "result_schema_ids"],
      "properties": {
        "terminal_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["succeeded", "failed", "cancelled", "compensated"]}
        },
        "result_schema_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 240}
        }
      }
    },
    "input_schema_id": {
      "const": "mindscape://durable-product-semantic-workflow/v1/execution_terminal_receipt"
    },
    "output_schema_id": {
      "const": "mindscape://durable-product-semantic-workflow/v1/outcome_observation"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^capabilities\\.[a-z][a-z0-9_]{1,63}\\.schema\\.[a-z][a-z0-9_\\.]*:[A-Za-z][A-Za-z0-9_]*$",
      "maxLength": 300
    },
    "authorized_lane": {"type": "string", "minLength": 1, "maxLength": 120},
    "installed_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "descriptor_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "activated_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "string", "minLength": 1, "maxLength": 4096}
  }
}
