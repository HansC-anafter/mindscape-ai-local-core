{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mindscape://durable-product-semantic-workflow/v1/approval",
  "title": "Durable Approval Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "workflow_id",
    "interrupt_id",
    "tool_call_id",
    "phase",
    "action_hash",
    "resume_payload_hash",
    "requested_by",
    "created_at",
    "expires_at",
    "signature"
  ],
  "properties": {
    "approval_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "workflow_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "interrupt_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "tool_call_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "phase": {"enum": ["request", "decision", "delivery", "consumption"]},
    "action_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "resume_payload_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "requested_by": {"type": "string", "minLength": 1, "maxLength": 200},
    "decided_by": {"type": ["string", "null"], "maxLength": 200},
    "decision": {"enum": ["approved", "rejected"]},
    "quorum": {"type": "integer", "minimum": 1, "maximum": 20},
    "separation_of_duties": {"type": "boolean"},
    "decision_receipt_id": {"type": ["string", "null"], "maxLength": 200},
    "delivery_id": {"type": ["string", "null"], "maxLength": 200},
    "consumed_effect_id": {"type": ["string", "null"], "maxLength": 200},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "string", "minLength": 1, "maxLength": 4096}
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "decision"}}},
      "then": {"required": ["decided_by", "decision", "quorum", "separation_of_duties"]}
    },
    {
      "if": {"properties": {"phase": {"const": "delivery"}}},
      "then": {"required": ["decision_receipt_id", "delivery_id"]}
    },
    {
      "if": {"properties": {"phase": {"const": "consumption"}}},
      "then": {
        "required": [
          "decision_receipt_id",
          "delivery_id",
          "consumed_effect_id"
        ]
      }
    }
  ]
}
