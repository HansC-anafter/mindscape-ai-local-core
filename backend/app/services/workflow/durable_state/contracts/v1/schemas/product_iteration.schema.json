{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mindscape://durable-product-semantic-workflow/v1/product_iteration",
  "title": "Product Iteration Aggregate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "iteration_id",
    "revision",
    "parent_iteration_id",
    "workspace_id",
    "objective",
    "state",
    "arms",
    "cohort",
    "metric_definitions",
    "validation_design",
    "evaluator",
    "evidence_frontier",
    "promotion_policy",
    "observation_window",
    "budget",
    "release_target",
    "definition_sha256",
    "created_at"
  ],
  "properties": {
    "iteration_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "revision": {"type": "integer", "minimum": 1},
    "parent_iteration_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "workspace_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "objective": {"type": "string", "minLength": 1, "maxLength": 1000},
    "state": {
      "enum": [
        "draft",
        "admitted",
        "collecting",
        "evidence_ready",
        "decision_pending",
        "inconclusive",
        "rejected",
        "promoted",
        "cancelled",
        "superseded"
      ]
    },
    "arms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "arm_id",
          "development_attestation_id",
          "development_attestation_sha256",
          "consumer_compatibility_class",
          "capability_identity",
          "configuration_fingerprint",
          "environment_fingerprint",
          "data_fingerprint",
          "consumer_impact_manifest_sha256",
          "allocation_weight"
        ],
        "properties": {
          "arm_id": {"type": "string", "minLength": 1, "maxLength": 120},
          "development_attestation_id": {"type": "string", "minLength": 1, "maxLength": 240},
          "development_attestation_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "consumer_compatibility_class": {
            "enum": ["compatible", "needs_review", "incompatible"]
          },
          "capability_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability_code", "pack_version", "manifest_sha256"],
            "properties": {
              "capability_code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,63}$"
              },
              "pack_version": {"type": "string", "minLength": 1, "maxLength": 100},
              "manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "configuration_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "environment_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "data_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "consumer_impact_manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "allocation_weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_hash",
        "case_manifest_ref",
        "population",
        "holdout",
        "randomization_method"
      ],
      "properties": {
        "definition_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "case_manifest_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri", "sha256", "bytes", "schema_id"],
          "properties": {
            "uri": {"type": "string", "minLength": 1, "maxLength": 2048},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "bytes": {"type": "integer", "minimum": 0},
            "schema_id": {"type": "string", "minLength": 1, "maxLength": 240}
          }
        },
        "population": {"type": "integer", "minimum": 1},
        "holdout": {"type": "boolean"},
        "randomization_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "exclusion_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "metric_definitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "direction", "denominator_definition", "quality_gate"],
        "properties": {
          "metric_id": {"type": "string", "minLength": 1, "maxLength": 120},
          "direction": {"enum": ["increase", "decrease", "within_range"]},
          "denominator_definition": {"type": "string", "minLength": 1, "maxLength": 500},
          "quality_gate": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "validation_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "power",
        "minimum_detectable_effect",
        "minimum_sample_size",
        "stopping_rule",
        "multiplicity_control",
        "holdout_policy",
        "leakage_guard",
        "missing_data_policy",
        "sequential_look_schedule",
        "evaluator_calibration",
        "evaluator_drift_threshold",
        "adjudication_policy"
      ],
      "properties": {
        "power": {"type": "number", "minimum": 0.8, "maximum": 1},
        "minimum_detectable_effect": {"type": "number", "exclusiveMinimum": 0},
        "minimum_sample_size": {"type": "integer", "minimum": 2},
        "stopping_rule": {"type": "string", "minLength": 1, "maxLength": 500},
        "multiplicity_control": {"type": "string", "minLength": 1, "maxLength": 200},
        "holdout_policy": {"type": "string", "minLength": 1, "maxLength": 500},
        "leakage_guard": {"type": "string", "minLength": 1, "maxLength": 500},
        "missing_data_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sequential_look_schedule": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "evaluator_calibration": {"type": "string", "minLength": 1, "maxLength": 500},
        "evaluator_drift_threshold": {"type": "number", "minimum": 0},
        "adjudication_policy": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_id", "version", "contract_hash"],
      "properties": {
        "evaluator_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "contract_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "evidence_frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_observation_sequence", "frontier_hash"],
      "properties": {
        "last_observation_sequence": {"type": "integer", "minimum": 0},
        "frontier_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "promotion_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_gates", "approval_policy_id"],
      "properties": {
        "required_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "approval_policy_id": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "observation_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at", "ends_at"],
      "properties": {
        "starts_at": {"type": "string", "format": "date-time"},
        "ends_at": {"type": "string", "format": "date-time"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_observations", "max_evaluation_attempts"],
      "properties": {
        "max_observations": {"type": "integer", "minimum": 1},
        "max_evaluation_attempts": {"type": "integer", "minimum": 1},
        "max_cost": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "release_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_id", "target_revision", "target_sha256"],
      "properties": {
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "target_revision": {"type": "string", "minLength": 1, "maxLength": 200},
        "target_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "definition_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "admitted_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
