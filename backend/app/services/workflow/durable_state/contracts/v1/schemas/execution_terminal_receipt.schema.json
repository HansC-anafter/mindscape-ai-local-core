{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mindscape://durable-product-semantic-workflow/v1/execution_terminal_receipt",
  "title": "Execution Terminal Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "workflow_id",
    "root_workflow_id",
    "execution_id",
    "attempt_id",
    "terminal_sequence",
    "workspace_id",
    "capability_identity",
    "terminal_state",
    "terminal_event_hash",
    "result_ref",
    "resource_summary",
    "artifact_refs",
    "development_attestation_id",
    "development_attestation_sha256",
    "consumer_compatibility_class",
    "configuration_fingerprint",
    "environment_fingerprint",
    "data_fingerprint",
    "workflow_definition_version",
    "reducer_version",
    "effect_adapter_registry_version",
    "runtime_build_id",
    "started_at",
    "completed_at",
    "key_id",
    "signature"
  ],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "workflow_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "root_workflow_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "execution_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "terminal_sequence": {"type": "integer", "minimum": 1},
    "workspace_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "capability_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_code", "pack_version", "manifest_sha256"],
      "properties": {
        "capability_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "pack_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "terminal_state": {"enum": ["succeeded", "failed", "cancelled", "compensated"]},
    "terminal_event_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "result_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "bytes", "schema_id"],
      "properties": {
        "uri": {"type": "string", "minLength": 1, "maxLength": 2048},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "schema_id": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "resource_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "attempts", "task_count"],
      "properties": {
        "duration_ms": {"type": "integer", "minimum": 0},
        "attempts": {"type": "integer", "minimum": 1},
        "task_count": {"type": "integer", "minimum": 0},
        "cpu_ms": {"type": "integer", "minimum": 0},
        "peak_memory_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "artifact_refs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "sha256", "bytes", "schema_id"],
        "properties": {
          "uri": {"type": "string", "minLength": 1, "maxLength": 2048},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "schema_id": {"type": "string", "minLength": 1, "maxLength": 240}
        }
      }
    },
    "development_attestation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "development_attestation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "consumer_compatibility_class": {
      "enum": ["compatible", "needs_review", "incompatible"]
    },
    "configuration_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "data_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "workflow_definition_version": {"type": "string", "minLength": 1, "maxLength": 100},
    "reducer_version": {"type": "string", "minLength": 1, "maxLength": 100},
    "effect_adapter_registry_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "runtime_build_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "signature": {"type": "string", "minLength": 1, "maxLength": 4096}
  }
}
